NEXT_PUBLIC_APP_NAME=CodeEdge Business OS

# CodeEdge SaaS core / Supabase
# Use HTTPS in hosted environments. Localhost/127.0.0.1 are allowed for development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ERPNext / Frappe - server-side only
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Required before Lead -> Customer sync is enabled for a workspace.
ERPNEXT_BUSINESS_ID=
ERPNEXT_CUSTOMER_GROUP=
ERPNEXT_TERRITORY=

# Never commit secret/service-role keys.

# Website Chat restricted server database connection.
# Must point to the same Supabase Postgres database. Hosted deployments require sslmode=verify-full.
CHAT_DATABASE_URL=
