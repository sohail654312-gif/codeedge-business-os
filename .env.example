NEXT_PUBLIC_APP_NAME=CodeEdge Business OS

# CodeEdge SaaS core / Supabase
# Use HTTPS in hosted environments. Localhost/127.0.0.1 are allowed for development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ERPNext / Frappe - server-side only
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Required before Lead -> Customer sync is enabled for a workspace.
ERPNEXT_BUSINESS_ID=
ERPNEXT_CUSTOMER_GROUP=
ERPNEXT_TERRITORY=

# Never commit secret/service-role keys.

# Website Chat restricted server database connection.
# Must point to the same Supabase Postgres database. Hosted deployments require sslmode=verify-full.
CHAT_DATABASE_URL=


# External communications restricted server database connection.
# Must point to the same Supabase Postgres database. Hosted deployments require sslmode=verify-full.
COMMUNICATION_DATABASE_URL=

# Meta WhatsApp Cloud API — server-side only.
# Set the Graph API version deliberately (for example, the version approved for your Meta app).
WHATSAPP_META_GRAPH_API_VERSION=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_VERIFY_TOKEN=
# Tenant-bound credential map. Legacy alias -> raw token entries fail closed.
# {"client_primary":{"businessId":"<codeedge-business-uuid>","provider":"meta_whatsapp_cloud","environment":"production","externalSenderId":"<meta-phone-number-id>","secret":"REPLACE_WITH_SERVER_SIDE_TOKEN"}}
WHATSAPP_META_CREDENTIALS_JSON=

# Resend Email — server-side only.
# Signed inbound/outbound event webhook secret (Svix-style whsec_...).
EMAIL_RESEND_WEBHOOK_SECRET=
# Tenant-bound credential map. externalSenderId is the configured sender email.
# {"client_primary":{"businessId":"<codeedge-business-uuid>","provider":"resend_email","environment":"production","externalSenderId":"support@example.com","secret":"REPLACE_WITH_SERVER_SIDE_RESEND_API_KEY"}}
EMAIL_RESEND_CREDENTIALS_JSON=

# Twilio SMS — server-side only.
# Tenant-bound credential map including the expected Twilio account and sender.
# {"client_primary":{"businessId":"<codeedge-business-uuid>","provider":"twilio_sms","environment":"production","externalAccountId":"AC...","externalSenderId":"+441234567890","secret":"REPLACE_WITH_SERVER_SIDE_TWILIO_AUTH_TOKEN"}}
SMS_TWILIO_CREDENTIALS_JSON=


# AI Voice — server-side only.
# Optional dedicated restricted DB connection; falls back to COMMUNICATION_DATABASE_URL.
VOICE_DATABASE_URL=
# Tenant-bound Vapi credential map.
# {"voice_primary":{"businessId":"<codeedge-business-uuid>","provider":"vapi","environment":"production","assistantId":"assistant-id","phoneNumberId":"phone-id","secret":"REPLACE_WITH_SERVER_SIDE_VAPI_PRIVATE_KEY"}}
VOICE_VAPI_CREDENTIALS_JSON=
# Tenant-bound webhook bearer map. externalAccountId is the Vapi assistant id and
# externalSenderId is the Vapi phone-number id resolved from the tenant connection.
# {"voice_primary":{"businessId":"<codeedge-business-uuid>","provider":"vapi","environment":"production","externalAccountId":"assistant-id","externalSenderId":"phone-id","secret":"REPLACE_WITH_LONG_WEBHOOK_BEARER"}}
VOICE_WEBHOOK_SECRETS_JSON=

# Automation Engine — server-side only.
# Optional dedicated restricted DB connection; falls back to COMMUNICATION_DATABASE_URL.
AUTOMATION_DATABASE_URL=
# Long random bearer secret used only by the internal Automation runner endpoint.
AUTOMATION_RUNNER_SECRET=

# Codeedge Money / Finance Engine — server-side only.
# Optional dedicated restricted DB connection; falls back to COMMUNICATION_DATABASE_URL.
FINANCE_DATABASE_URL=
# Server-trusted ERPNext credential/config map selected only by opaque Finance connection keys.
# Example:
# {"finance_primary":{"businessId":"<codeedge-business-uuid>","baseUrl":"https://erp.example","apiKey":"...","apiSecret":"...","customerGroup":"Commercial","territory":"All Territories"}}
FINANCE_ERPNEXT_CREDENTIALS_JSON=


# Codeedge AI Runtime / AI Accountant — server-side only.
# Optional dedicated restricted DB connection; falls back to FINANCE_DATABASE_URL,
# then COMMUNICATION_DATABASE_URL.
AI_DATABASE_URL=
# Tenant-bound model credentials. Demo workspaces never require a production model.
# Endpoint must be a trusted HTTPS OpenAI-compatible /chat/completions endpoint
# (localhost HTTP/HTTPS is allowed only for local development).
# Example:
# {"clinic_ai":{"businessId":"<codeedge-business-uuid>","provider":"openai_compatible","environment":"production","endpoint":"https://api.example.com/v1/chat/completions","apiKey":"...","model":"..."}}
AI_MODEL_CREDENTIALS_JSON=
